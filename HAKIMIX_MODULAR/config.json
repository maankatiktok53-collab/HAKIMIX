{
  "general": {
    "output_dir": "output",
    "default_timeout": 120,
    "verbose": false,
    "max_report_lines": 400,
    "confirm_authorization": true,
    "reuse_existing": false,
    "max_result_age_hours": 24
  },
  "tools": {
    "python3": {"required": true, "min_version": 3},
    "nmap": {"required": false},
    "curl": {"required": false},
    "dig": {"required": false},
    "whois": {"required": false},
    "openssl": {"required": false},
    "whatweb": {"required": false},
    "nikto": {"required": false},
    "gobuster": {"required": false},
    "feroxbuster": {"required": false},
    "john": {"required": false},
    "hashcat": {"required": false}
  },
  "scan": {
    "nmap": {
      "common_ports": "1-1000",
      "full_ports": "1-65535",
      "top_ports": "1000",
      "tcp_connect_fallback": true,
      "service_version": false,
      "version_intensity": 2,
      "script_scan": false
    },
    "web": {
      "top_ports": [80, 443, 8080, 8443, 8000, 8008, 8888, 3000, 5000, 7000, 9000],
      "connect_timeout": 5,
      "max_redirects": 3,
      "directory_wordlist": "/usr/share/wordlists/dirb/common.txt",
      "directory_threads": 10,
      "directory_timeout": 90,
      "directory_limit": 200,
      "directory_scan": true,
      "vhost_wordlist": "/usr/share/wordlists/amass/subdomains.txt",
      "vhost_limit": 30,
      "vhost_scan": true,
      "nikto_enabled": false,
      "max_scan_urls": 2
    },
    "dns": {
      "record_types": ["A", "AAAA", "MX", "NS", "TXT", "CNAME", "SOA"],
      "subdomain_wordlist": "/usr/share/wordlists/amass/subdomains.txt",
      "subdomain_limit": 200,
      "resolver_timeout": 3
    },
    "service": {
      "banner_timeout": 3,
      "max_banner_bytes": 2048
    },
    "hash": {
      "john_format_auto": true,
      "hashcat_cpu_only": true,
      "max_crack_time": 300
    },
    "privesc": {
      "suid_scan_paths": ["/usr/bin", "/bin", "/usr/sbin", "/sbin", "/usr/local/bin", "/opt"],
      "max_suid_results": 500,
      "writable_scan_paths": ["/etc", "/opt", "/usr/local", "/home", "/tmp", "/var"],
      "max_writable_results": 300
    }
  },
  "modules": {
    "recon": {"scripts": ["01_RECON/recon.py"], "needs": [], "provides": ["domains", "ips", "subdomains"]},
    "web": {"scripts": ["02_WEB/web.py"], "needs": ["network"], "provides": ["web_ports", "technologies", "web_findings"]},
    "network": {"scripts": ["03_NETWORK/nmap_scan.py", "03_NETWORK/dns_enum.py", "03_NETWORK/service_enum.py"], "needs": [], "provides": ["ports", "services", "dns_records"]},
    "analysis": {"scripts": ["04_ANALYSIS/analysis.py"], "needs": ["recon", "web", "network"], "provides": ["findings", "priorities"]},
    "privesc": {"scripts": ["05_PRIVESC/linux_privesc.py", "05_PRIVESC/windows_privesc.py"], "needs": [], "provides": ["local_findings"]},
    "hash": {"scripts": ["06_HASH/hash.py"], "needs": [], "provides": ["hash_analysis"]}
  }
}
